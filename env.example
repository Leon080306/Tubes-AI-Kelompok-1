# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=query_optimizer_db

# Read-only database account
DB_READ_USER=optimizer_reader
DB_READ_PASSWORD=CHANGE_ME_READER

# DBA account used only after Human-in-the-Loop approval
DB_DBA_USER=optimizer_dba
DB_DBA_PASSWORD=CHANGE_ME_DBA

# Ollama local models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
